# CONFIG_GCC_PLUGINS is not set

# Allow to load kernel modules built with different kernel version
CONFIG_MODVERSIONS=y

# Support of iks01a2
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_HTS221=y
CONFIG_IIO_ST_PRESS=m
CONFIG_IIO_ST_LSM6DSX=m
CONFIG_IIO_ST_LSM6DSX_I2C=m

# support of event emulation
CONFIG_INPUT_UINPUT=m

# USBIP
CONFIG_USBIP_CORE=m
CONFIG_USBIP_HOST=m
# CONFIG_USBIP_DEBUG is not set

# Needed for lttng-modules
CONFIG_KPROBES=y

# Needed to plug external device (e.g. plug STLinkvx)
CONFIG_USB_ACM=m

# Ethernet (STM32 GMAC)
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=m
CONFIG_STMMAC_PLATFORM=m
CONFIG_DWMAC_GENERIC=m
CONFIG_DWMAC_STM32=m
CONFIG_DWMAC_DWC_QOS_ETH=m

# Ethernet PHY (LAN8742)
CONFIG_SMSC_PHY=m
CONFIG_MOTORCOMM_PHY=m

# HDMI Bridge (SiI9022)
CONFIG_DRM_SII902X=m

 # Crypt
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_USER=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m

# For QT usage, need to activate CONFIG_DRM_FBDEV_EMULATION when there is no GPU
#CONFIG_DRM_FBDEV_EMULATION=y
#CONFIG_DRM_FBDEV_OVERALLOC=200
